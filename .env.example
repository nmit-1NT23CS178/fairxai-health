# Copy to .env for local development (never commit .env).
# In production (Render) set these in the service dashboard instead.

APP_ENV=development            # "production" disables debug and the in-memory DB fallback
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# MongoDB: local -> mongodb://localhost:27017 | Atlas -> mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=
MONGO_DB=fairxai
# Dev only: if MONGO_URI is empty and this is 1, an in-memory (NON-persistent) DB is used.
ALLOW_MEMORY_DB=1

# Required in production for upload / clean / train / delete (sent as the X-Admin-Token header).
ADMIN_TOKEN=

# Only needed for a separate frontend origin; the bundled dashboard is same-origin.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

MAX_UPLOAD_MB=25
PREDICTION_RETENTION_DAYS=90
# 0 = store only scores/explanations, never the patient inputs (recommended for a public demo).
STORE_PREDICTION_INPUTS=1
RANDOM_SEED=42

# ---- Production example (Render) ----
# APP_ENV=production
# MONGO_URI=mongodb+srv://fairxai_app:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB=fairxai
# ALLOW_MEMORY_DB=0
# ADMIN_TOKEN=<long random string>
# STORE_PREDICTION_INPUTS=0
# CORS_ORIGINS=https://<your-app>.onrender.com
