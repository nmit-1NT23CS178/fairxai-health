# Copy to .env (never commit .env)
APP_ENV=development            # set to "production" when deployed
HOST=127.0.0.1
PORT=5000
# MongoDB: local  -> mongodb://localhost:27017   |   Atlas -> mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=
MONGO_DB=fairxai
# If MONGO_URI is empty AND this is 1, an in-memory (non-persistent) DB is used - development only.
ALLOW_MEMORY_DB=1
# Required in production to use upload / clean / train / delete endpoints (send as X-Admin-Token header)
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
MAX_UPLOAD_MB=25
PREDICTION_RETENTION_DAYS=90
STORE_PREDICTION_INPUTS=1      # set 0 to store only scores/explanations, not patient inputs
RANDOM_SEED=42
